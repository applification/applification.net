        {
          "type": "frame",
          "id": "JAhqr",
          "name": "Why Contexture exists",
          "width": "fill_container",
          "height": 370,
          "fill": "$app-section",
          "gap": 90,
          "padding": [
            62,
            80
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "KGAmt",
              "name": "Contexture rationale lead",
              "width": 500,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "SBY9V",
                  "name": "Contexture rationale eyebrow",
                  "fill": "#7C3AED",
                  "content": "WHY THIS EXISTS",
                  "fontFamily": "$font-caption",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "nfF3O",
                  "name": "Contexture rationale title",
                  "fill": "$app-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A schema change should not leave five different truths behind.",
                  "lineHeight": 1.08,
                  "fontFamily": "$font-heading",
                  "fontSize": 40,
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Kt8hy",
              "name": "Contexture rationale body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "text",
                  "id": "GVQHT",
                  "name": "Contexture rationale paragraph",
                  "fill": "$app-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "In an agent-built app, drift compounds quickly. The database accepts one shape, forms accept another, and the agent works from old assumptions. Contexture turns the reviewed model into generated contracts that can be checked before code ships.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "kSPPk",
                  "name": "Contexture rationale note",
                  "width": "fill_container",
                  "fill": "#F3E8FF",
