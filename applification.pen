                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "F18vDU",
                  "name": "Article content",
                  "width": 720,
                  "layout": "vertical",
                  "gap": 28,
                  "children": [
                    {
                      "type": "text",
                      "id": "hLl3V",
                      "name": "Article opening paragraph",
                      "fill": "$app-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Coding agents can produce a frightening amount of code before lunch. That speed is useful, but it is not the hard part. The hard part is making sure the agent is solving the right problem and leaving enough evidence for a person to trust the result.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-heading",
                      "fontSize": 25,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "Ub6ri",
                      "name": "Context before action heading",
                      "fill": "$app-text-primary",
                      "content": "Context before action",
                      "lineHeight": 1.1,
                      "fontFamily": "$font-heading",
                      "fontSize": 38,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "W2nECU",
                      "name": "Context before action paragraph one",
                      "fill": "$app-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Most agent failures start before the agent writes code. The task is vague, the product decision is missing, or the relevant constraint lives in somebody's head. A larger prompt does not fix that. The agent needs the same product model the team is using.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "iXKYk",
                      "name": "Context before action paragraph two",
                      "fill": "$app-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "StoryLoops makes the intended product change explicit. Contexture gives the app and the agent one reviewed domain model. Together they reduce the number of decisions an agent has to invent while it works.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "CZiXC",
                      "name": "Article pull quote",
                      "width": "fill_container",
                      "stroke": "$app-accent",
                      "strokeWidth": {
                        "left": 3
                      },
                      "padding": [
                        6,
                        0,
                        6,
                        24
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "MbkA6",
                          "name": "Article pull quote text",
                          "fill": "$app-text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The agent should move quickly inside an agreed boundary. Changing the boundary is a product decision.",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-heading",
                          "fontSize": 28,
                          "fontWeight": "500"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "A9sDY",
                      "name": "The loop I use heading",
                      "fill": "$app-text-primary",
                      "content": "The loop I use",
                      "lineHeight": 1.1,
                      "fontFamily": "$font-heading",
                      "fontSize": 38,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "c7brB",
                      "name": "The loop I use introduction",
                      "fill": "$app-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The loop is deliberately boring. Each stage has one job, and each hand-off leaves something inspectable behind.",
