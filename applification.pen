                          "fontSize": 12,
                          "fontWeight": "700",
                          "letterSpacing": 0.8
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "otumr",
                      "name": "What stays human heading",
                      "fill": "$app-text-primary",
                      "content": "What stays human",
                      "lineHeight": 1.1,
                      "fontFamily": "$font-heading",
                      "fontSize": 38,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "VDai6",
                      "name": "What stays human paragraph",
                      "fill": "$app-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The agent can search, edit, run and report. I still want a person to own the product boundary, judge the evidence, and decide whether the change belongs. That is not a concession to current models. It is how the product keeps an author.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
