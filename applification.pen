                      "fill": "#153447",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Plan a few days. Cook what works. Teach the next plan.",
                      "lineHeight": 1.08,
                      "fontFamily": "$font-heading",
