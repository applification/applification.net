        {
          "type": "frame",
          "id": "gn6YY",
          "name": "Why Plantry exists",
          "width": "fill_container",
          "height": 370,
          "fill": "#153447",
          "gap": 90,
          "padding": [
            62,
            80
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "p2VThY",
              "name": "Plantry rationale lead",
              "width": 500,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "L3bYn4",
                  "name": "Plantry rationale eyebrow",
                  "fill": "#78D696",
                  "content": "WHY THIS EXISTS",
                  "fontFamily": "$font-caption",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "mFCJN",
                  "name": "Plantry rationale title",
                  "fill": "#FFFBef",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A technically perfect meal plan can still be useless by Tuesday.",
                  "lineHeight": 1.08,
                  "fontFamily": "$font-heading",
                  "fontSize": 40,
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "g4DDd",
              "name": "Plantry rationale body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "text",
                  "id": "Q5SbGV",
                  "name": "Plantry rationale paragraph",
                  "fill": "#D7E3E3",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Meal planning breaks when it ignores energy, leftovers and the people around the table. Plantry treats the plan as a short household forecast, then learns from what was cooked, skipped or changed.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "H6jse",
                  "name": "Plantry planning principle",
                  "width": "fill_container",
                  "fill": "#244354",
                  "cornerRadius": 14,
                  "gap": 14,
                  "padding": 18,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "q9TuL",
                      "name": "Plantry planning principle icon",
                      "width": 26,
                      "height": 26,
                      "icon": "refresh-cw",
                      "library": "lucide",
                      "fill": "#78D696"
                    },
                    {
                      "type": "text",
                      "id": "viTnW",
                      "name": "Plantry planning principle text",
                      "fill": "#FFFBef",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A useful plan adapts to the household instead of asking the household to obey it.",
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "600"
                    }
                  ]
                }
              ]
            }
          ]
        },
