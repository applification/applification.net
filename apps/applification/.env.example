# Contact is enabled automatically in local development. Production requires this flag.
CONTACT_WORKFLOW_ENABLED=true

# Use a budgeted AI Gateway key. Contact preparation does not fall back to OIDC.
# Optional contact-only key takes precedence over AI_GATEWAY_API_KEY.
CONTACT_AI_GATEWAY_API_KEY=
AI_GATEWAY_API_KEY=
CONTACT_AI_MODEL=

# Connect a private Vercel Blob store to the project for optional contract briefs.
BLOB_READ_WRITE_TOKEN=

# Durable delivery. Use a sending-only Resend key and a verified From domain.
RESEND_API_KEY=
CONTACT_DELIVERY_TO=
CONTACT_DELIVERY_FROM=
CONTACT_PUBLIC_BASE_URL=http://localhost:3333
CONTACT_ATTACHMENT_ACCESS_SECRET=
CONTACT_RATE_LIMIT_SECRET=

# Owner-only contract CV review. Upload the PDF to this private Blob pathname.
CONTACT_OWNER_REVIEW_SECRET=
CONTACT_CV_BLOB_PATHNAME=contact/cv/dave-hudson.pdf
CONTACT_CV_FILENAME=Dave-Hudson-CV.pdf
CONTACT_CV_VERSION=
